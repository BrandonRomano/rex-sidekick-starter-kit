{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '\"$HOME/.claude/hooks/rex-tab-name.sh\" 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '\"$HOME/.claude/hooks/rex-notify.sh\" 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '\"$HOME/.claude/hooks/rex-notify.sh\" 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '\"$HOME/.claude/hooks/rex-notify.sh\" 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '\"$HOME/.claude/hooks/rex-notify.sh\" 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '\"$HOME/.claude/hooks/rex-notify.sh\" 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '\"$HOME/.claude/hooks/rex-notify.sh\" 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '\"$HOME/.claude/hooks/rex-notify.sh\" 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
